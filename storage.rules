rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The payload is AES-256-GCM encrypted on the device. Still require an
    // authenticated Firebase session before allowing any object access.
    match /backups/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

