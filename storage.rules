rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Backups are encrypted on the device, but access is still restricted to
    // the Firebase account that owns the UID-prefixed object path.
    match /backups/{uid}/{backupFile} {
      allow read, write, delete: if request.auth != null
        && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

