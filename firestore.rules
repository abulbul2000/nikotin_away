rules_version = '2';

// This project keeps user data on-device by default (see CLAUDE.md). The
// only server-side Firestore data is the trial-start timestamp and daily AI
// message quota used to stop a forged client from bypassing subscription
// checks (see functions/index.js) — the client never reads or writes this
// collection directly, only the Cloud Functions (Admin SDK, which bypasses
// these rules) do. Keeping this closed avoids opening a second access path
// that would have to be kept in sync with the server-side checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
