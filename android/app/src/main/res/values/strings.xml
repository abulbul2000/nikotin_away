    <string name="shortcut_craving_long">Kriz anı desteği aç</string>
    <string name="shortcut_self_challenge_short">Meydan Oku</string>
    <string name="shortcut_self_challenge_long">Kendi meydan okumanı başlat</string>
    <string name="shortcut_open_app_short">Uygulamayı Aç</string>
    <string name="shortcut_open_app_long">Nikotin Away\'i aç</string>
